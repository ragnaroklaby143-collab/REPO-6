rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'sullenshades@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidFighter(f) {
      return f in ['marjohn', 'prime', 'damen', 'khen', 'jm'];
    }

    function isValidStatus(s) {
      return s in ['online', 'in-match', 'offline'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'onlineStatus',
        'coins',
        'wins',
        'losses',
        'totalKOs',
        'matchesPlayed',
        'favoriteFighter',
        'matchHistory',
        'banned',
        'createdAt',
        'lastLogin'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'onlineStatus',
        'coins',
        'googleBonusClaimed',
        'wins',
        'losses',
        'totalKOs',
        'matchesPlayed',
        'favoriteFighter',
        'unlockedSkins',
        'equippedSkins',
        'matchHistory',
        'banned',
        'createdAt',
        'lastLogin'
      ]) &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
      data.photoURL is string && data.photoURL.size() <= 512 &&
      data.role in ['player', 'admin'] &&
      isValidStatus(data.onlineStatus) &&
      data.coins is int && data.coins >= 0 && data.coins <= 10000000 &&
      (!('googleBonusClaimed' in data) || data.googleBonusClaimed is bool) &&
      data.wins is int && data.wins >= 0 && data.wins <= 1000000 &&
      data.losses is int && data.losses >= 0 && data.losses <= 1000000 &&
      data.totalKOs is int && data.totalKOs >= 0 && data.totalKOs <= 10000000 &&
      data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 2000000 &&
      isValidFighter(data.favoriteFighter) &&
      (!('unlockedSkins' in data) || (data.unlockedSkins is list && data.unlockedSkins.size() <= 30)) &&
      (!('equippedSkins' in data) || (data.equippedSkins is map && data.equippedSkins.size() <= 5)) &&
      data.matchHistory is list && data.matchHistory.size() <= 15 &&
      (data.matchHistory.size() == 0 || data.matchHistory[0] is map) &&
      data.banned is bool &&
      data.createdAt is timestamp &&
      data.lastLogin is timestamp;
    }

    function isValidSelfCreate(data, userId) {
      return data.uid == request.auth.uid &&
        data.uid == userId &&
        data.role == 'player' &&
        data.banned == false &&
        ((data.coins == 1000 && 'googleBonusClaimed' in data && data.googleBonusClaimed == true) ||
         (data.coins == 100 && !('googleBonusClaimed' in data))) &&
        data.wins == 0 &&
        data.losses == 0 &&
        data.totalKOs == 0 &&
        data.matchesPlayed == 0 &&
        (!('unlockedSkins' in data) || data.unlockedSkins.size() == 0) &&
        (!('equippedSkins' in data) || data.equippedSkins.size() == 0) &&
        data.matchHistory.size() == 0 &&
        data.createdAt == request.time &&
        data.lastLogin == request.time;
    }

    function isSelfPresenceUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
        'displayName',
        'photoURL',
        'email',
        'onlineStatus',
        'favoriteFighter',
        'lastLogin'
      ]) &&
      incoming().uid == existing().uid &&
      incoming().createdAt == existing().createdAt &&
      incoming().lastLogin == request.time &&
      incoming().role == existing().role &&
      incoming().banned == existing().banned;
    }

    function isSelfClaimGoogleBonusUpdate() {
      return existing().banned == false &&
        (!('googleBonusClaimed' in existing()) || existing().googleBonusClaimed == false) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'email',
          'onlineStatus',
          'coins',
          'googleBonusClaimed',
          'lastLogin'
        ]) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLogin == request.time &&
        incoming().role == existing().role &&
        incoming().banned == existing().banned &&
        incoming().googleBonusClaimed == true &&
        incoming().coins == existing().coins + 1000;
    }

    function isSelfMatchCommitUpdate() {
      return existing().banned == false &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'onlineStatus',
          'coins',
          'wins',
          'losses',
          'totalKOs',
          'matchesPlayed',
          'favoriteFighter',
          'matchHistory',
          'lastLogin'
        ]) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLogin == request.time &&
        incoming().role == existing().role &&
        incoming().banned == existing().banned &&
        incoming().coins >= existing().coins &&
        incoming().coins <= existing().coins + 200 &&
        incoming().wins >= existing().wins &&
        incoming().wins <= existing().wins + 1 &&
        incoming().losses >= existing().losses &&
        incoming().losses <= existing().losses + 1 &&
        incoming().totalKOs >= existing().totalKOs &&
        incoming().totalKOs <= existing().totalKOs + 30 &&
        incoming().matchesPlayed == existing().matchesPlayed + 1;
    }

    function isSelfSkinPurchaseUpdate() {
      return existing().banned == false &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'coins',
          'unlockedSkins',
          'lastLogin'
        ]) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLogin == request.time &&
        incoming().role == existing().role &&
        incoming().banned == existing().banned &&
        (existing().coins - incoming().coins == 1000 || existing().coins - incoming().coins == 5000) &&
        incoming().coins >= 0 &&
        incoming().unlockedSkins is list &&
        incoming().unlockedSkins.size() == (('unlockedSkins' in existing() ? existing().unlockedSkins.size() : 0) + 1);
    }

    function isSelfEquipSkinsUpdate() {
      return existing().banned == false &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'equippedSkins',
          'lastLogin'
        ]) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLogin == request.time &&
        incoming().role == existing().role &&
        incoming().banned == existing().banned &&
        incoming().equippedSkins is map &&
        incoming().equippedSkins.size() <= 5;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isVerified() &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        isValidSelfCreate(incoming(), userId);
      allow update: if isValidId(userId) &&
        isVerified() &&
        isValidUserProfile(incoming()) && (
          (isAdmin() &&
            incoming().uid == existing().uid &&
            incoming().createdAt == existing().createdAt) ||
          (isOwner(userId) && (
            isSelfPresenceUpdate() ||
            isSelfClaimGoogleBonusUpdate() ||
            isSelfMatchCommitUpdate() ||
            isSelfSkinPurchaseUpdate() ||
            isSelfEquipSkinsUpdate()
          ))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list, write: if false;
    }
  }
}
